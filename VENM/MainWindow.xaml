<Window x:Class="VENM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Визуальный Редактор Файлов"
        Height="720" Width="1024"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ ПАНЕЛЬ УПРАВЛЕНИЯ ═══ -->
        <Border x:Name="ControlPanel" Grid.Column="0" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="LblLanguage" Text="Язык:" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ComboLanguage" SelectionChanged="ComboLanguage_SelectionChanged"/>
                </StackPanel>

                <Button x:Name="BtnOpenAssets" Grid.Row="1" Content="Открыть ресурсы" Margin="0,0,0,5" Click="BtnOpenAssets_Click"/>
                <Button x:Name="BtnCreateDemo" Grid.Row="2" Content="Создать демо-структуру" Margin="0,0,0,15" Click="BtnCreateDemo_Click"/>

                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="Режим редактирования:" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ComboEditMode" SelectionChanged="ComboEditMode_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,8">
                    <TextBlock Text="Сцена:" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ComboScene" SelectionChanged="Combo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,0,0,8">
                    <TextBlock Text="Объект:" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ComboObject" SelectionChanged="Combo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="6" VerticalAlignment="Center" Margin="0,8,0,8">
                    <TextBlock Text="Файл:" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ComboFile" SelectionChanged="Combo_SelectionChanged"/>
                </StackPanel>

                <CheckBox x:Name="HideObject" Grid.Row="7" Content="Скрыть объект" Margin="0,0,0,8"
                          Checked="HideObject_Checked" Unchecked="HideObject_Unchecked"/>

                <!-- 🔹 НОВАЯ КНОПКА переключения положения панели -->
                <Button x:Name="BtnTogglePanel" Grid.Row="8" Content="⇄ Панель" Margin="0,0,0,8" Click="BtnTogglePanel_Click"/>

                <CheckBox x:Name="AutoSave" Grid.Row="9" Content="Автосохранение" Margin="0,0,0,10"
                          Checked="AutoSave_Checked" Unchecked="AutoSave_Unchecked"/>
                <Button x:Name="BtnSave" Grid.Row="10" Content="Сохранить" Click="BtnSave_Click"/>
            </Grid>
        </Border>

        <!-- ═══ КОНТЕНТ ═══ -->
        <Grid x:Name="ContentArea" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <!-- Просмотрщик сцены -->
            <Border Grid.Row="0" Margin="10,10,10,0" BorderBrush="Gray" BorderThickness="1"
            Background="Black" ClipToBounds="True"
            AllowDrop="True" Drop="SceneCanvas_Drop" DragOver="SceneCanvas_DragOver">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="SceneCanvas" Width="1920" Height="1080" Background="#1E1E1E"
                MouseLeftButtonDown="SceneCanvas_MouseDown"
                MouseMove="SceneCanvas_MouseMove"
                PreviewMouseLeftButtonUp="SceneCanvas_MouseUp"/>
                </Viewbox>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="LightGray" ResizeBehavior="PreviousAndNext"/>

            <!-- Редактор + просмотрщик примеров -->
            <Grid Grid.Row="2" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="TextEditor" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Visibility="Visible"/>
                        <ScrollViewer x:Name="JsonEditorScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="JsonEditorPanel" Margin="5"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="LightGray" ResizeBehavior="PreviousAndNext"/>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="TextPreview" TextWrapping="Wrap" IsReadOnly="True" Background="#F5F5F5" VerticalScrollBarVisibility="Auto" Visibility="Visible"/>
                        <ScrollViewer x:Name="JsonPreviewScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="JsonPreviewPanel" Margin="5"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>