<Window x:Class="VENM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Визуальный Редактор Файлов"
        Height="720" Width="1024"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ ПАНЕЛЬ УПРАВЛЕНИЯ (3 зоны) ═══ -->
        <Border x:Name="ControlPanel" Grid.Column="0" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Зона 1: быстрые настройки -->
                    <RowDefinition Height="*"/>
                    <!-- Зона 2: настройка сцены -->
                    <RowDefinition Height="Auto"/>
                    <!-- Зона 3: сохранение -->
                </Grid.RowDefinitions>

                <!-- ═══ ЗОНА 1: Быстрые настройки ═══ -->
                <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock x:Name="LblLanguage" Text="Язык:" Margin="0,0,0,3" FontSize="11" Foreground="#555"/>
                        <ComboBox x:Name="ComboLanguage" Margin="0,0,0,6" SelectionChanged="ComboLanguage_SelectionChanged"/>
                        <Button x:Name="BtnTogglePanel" Content="⇄ Панель" Margin="0,0,0,4" Click="BtnTogglePanel_Click"/>
                        <Button x:Name="BtnOpenAssets" Content="Открыть ресурсы" Margin="0,0,0,4" Click="BtnOpenAssets_Click"/>
                        <Button x:Name="BtnCreateDemo" Content="Создать демо-структуру" Click="BtnCreateDemo_Click"/>
                    </StackPanel>
                </Border>

                <!-- ═══ ЗОНА 2: Настройка сцены (прокручиваемая) ═══ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4">
                    <StackPanel>
                        <TextBlock x:Name="LblEditMode" Text="Режим редактирования:" Margin="0,0,0,3" FontSize="11" Foreground="#555"/>
                        <ComboBox x:Name="ComboEditMode" Margin="0,0,0,8" SelectionChanged="ComboEditMode_SelectionChanged"/>

                        <TextBlock x:Name="LblScene" Text="Сцена:" Margin="0,0,0,3" FontSize="11" Foreground="#555"/>
                        <ComboBox x:Name="ComboScene" Margin="0,0,0,8" SelectionChanged="Combo_SelectionChanged"/>

                        <TextBlock x:Name="LblObject" Text="Объект:" Margin="0,0,0,3" FontSize="11" Foreground="#555"/>
                        <ComboBox x:Name="ComboObject" Margin="0,0,0,8" SelectionChanged="Combo_SelectionChanged"/>

                        <TextBlock x:Name="LblFile" Text="Файл:" Margin="0,0,0,3" FontSize="11" Foreground="#555"/>
                        <ComboBox x:Name="ComboFile" Margin="0,0,0,8" SelectionChanged="Combo_SelectionChanged"/>

                        <CheckBox x:Name="HideObject" Content="Скрыть объект" Margin="0,4,0,0"
                                  Checked="HideObject_Checked" Unchecked="HideObject_Unchecked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ ЗОНА 3: Сохранение ═══ -->
                <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
                    <StackPanel>
                        <CheckBox x:Name="AutoSave" Content="Автосохранение" Margin="0,0,0,8"
                                  Checked="AutoSave_Checked" Unchecked="AutoSave_Unchecked"/>
                        <Button x:Name="BtnSave" Content="Сохранить" Click="BtnSave_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ КОНТЕНТ ═══ -->
        <Grid x:Name="ContentArea" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <!-- Просмотрщик сцены -->
            <Border Grid.Row="0" Margin="10,10,10,0" BorderBrush="Gray" BorderThickness="1"
                    Background="Black" ClipToBounds="True"
                    AllowDrop="True" Drop="SceneCanvas_Drop" DragOver="SceneCanvas_DragOver">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="SceneCanvas" Width="1920" Height="1080" Background="#1E1E1E"
                            MouseLeftButtonDown="SceneCanvas_MouseDown"
                            MouseMove="SceneCanvas_MouseMove"
                            PreviewMouseLeftButtonUp="SceneCanvas_MouseUp"/>
                </Viewbox>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="LightGray" ResizeBehavior="PreviousAndNext"/>

            <!-- Редактор + просмотрщик примеров -->
            <Grid Grid.Row="2" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="TextEditor" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Visibility="Visible"/>
                        <ScrollViewer x:Name="JsonEditorScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="JsonEditorPanel" Margin="5"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="LightGray" ResizeBehavior="PreviousAndNext"/>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="TextPreview" TextWrapping="Wrap" IsReadOnly="True" Background="#F5F5F5" VerticalScrollBarVisibility="Auto" Visibility="Visible"/>
                        <ScrollViewer x:Name="JsonPreviewScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="JsonPreviewPanel" Margin="5"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>